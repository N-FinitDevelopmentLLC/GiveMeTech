<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630" viewBox="0 0 1200 630" role="img" aria-labelledby="title description">
  <title id="title">SlothSort: files sorted, effort minimized</title>
  <desc id="description">A relaxed sloth watches as scattered files are organized into labeled folders by a local AI helper.</desc>
  <defs>
    <linearGradient id="background" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#102a2a"/>
      <stop offset="1" stop-color="#214b43"/>
    </linearGradient>
    <linearGradient id="folder" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f6c86f"/>
      <stop offset="1" stop-color="#e6a943"/>
    </linearGradient>
  </defs>
  <rect width="1200" height="630" rx="32" fill="url(#background)"/>
  <circle cx="1030" cy="90" r="150" fill="#bfe5bb" opacity=".08"/>
  <circle cx="200" cy="580" r="220" fill="#bfe5bb" opacity=".06"/>
  <text x="80" y="125" fill="#bfe5bb" font-family="Arial, sans-serif" font-size="22" font-weight="700" letter-spacing="4">LOCAL-FIRST FILE ORGANIZER</text>
  <text x="76" y="223" fill="#fffaf0" font-family="Arial, sans-serif" font-size="76" font-weight="800">SlothSort</text>
  <text x="82" y="273" fill="#d6e8d7" font-family="Arial, sans-serif" font-size="29">Files sorted. Effort minimized.</text>
  <g transform="translate(770 175)">
    <path d="M76 72h96l22 25h125a18 18 0 0 1 18 18v170a22 22 0 0 1-22 22H55a22 22 0 0 1-22-22V94a22 22 0 0 1 22-22z" fill="url(#folder)"/>
    <path d="M33 137h304l-25 134a20 20 0 0 1-20 16H56a20 20 0 0 1-20-16z" fill="#f4d98f"/>
    <text x="75" y="197" fill="#34483b" font-family="Arial, sans-serif" font-size="21" font-weight="700">Documents</text>
    <text x="75" y="235" fill="#34483b" font-family="Arial, sans-serif" font-size="21" font-weight="700">Images</text>
    <text x="75" y="273" fill="#34483b" font-family="Arial, sans-serif" font-size="21" font-weight="700">And the rest...</text>
  </g>
  <g transform="translate(547 310)">
    <path d="M-10 25c-38-12-48-50-28-77 20-26 61-22 73 8 10 27-5 54-45 69z" fill="#a77855"/>
    <ellipse cx="7" cy="32" rx="44" ry="39" fill="#c6a17a"/>
    <ellipse cx="9" cy="20" rx="26" ry="25" fill="#f0dfbf"/>
    <circle cx="2" cy="16" r="4" fill="#2a302b"/>
    <circle cx="18" cy="16" r="4" fill="#2a302b"/>
    <path d="M5 28q8 7 16 0" fill="none" stroke="#76543f" stroke-width="3" stroke-linecap="round"/>
    <path d="M-22 68q5 28 22 29 17-1 22-29" fill="#a77855"/>
  </g>
  <g fill="#fffaf0" font-family="Arial, sans-serif" font-size="19" font-weight="700">
    <text x="555" y="254">local model</text>
    <text x="546" y="280">filename only</text>
  </g>
  <path d="M627 282c39-24 77-29 119-24" fill="none" stroke="#bfe5bb" stroke-width="4" stroke-dasharray="8 10"/>
  <path d="m735 247 16 10-17 9" fill="none" stroke="#bfe5bb" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
  <text x="82" y="552" fill="#bfe5bb" font-family="Arial, sans-serif" font-size="20">Open-source AI Challenge · Week 3 · Slow and Steady</text>
</svg>
