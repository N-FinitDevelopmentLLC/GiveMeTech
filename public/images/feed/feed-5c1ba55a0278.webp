<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1200 675' width='1200' height='675' font-family='Inter,Helvetica,Arial,sans-serif'><rect width='1200' height='675' fill='#fbfaf8'/><defs><marker id='a' viewBox='0 0 10 10' refX='8' refY='5' markerWidth='6' markerHeight='6' orient='auto'><path d='M0 0L10 5L0 10z' fill='#ff4a1c'/></marker></defs><text x='60' y='80' font-size='34' font-weight='800' fill='#121212'>Figma auto layout → CSS</text><rect x='60' y='130' width='480' height='52' rx='10' fill='#fff' stroke='#e5e5e5'/><text x='80' y='164' font-size='20' fill='#121212'>Horizontal / vertical</text><line x1='548' y1='156' x2='618' y2='156' stroke='#ff4a1c' stroke-width='4' marker-end='url(#a)'/><rect x='625' y='130' width='515' height='52' rx='10' fill='#fff6f2' stroke='#ffd9cc'/><text x='645' y='164' font-size='19' font-family='ui-monospace,Menlo,monospace' fill='#121212'>flex-direction: row / column</text><rect x='60' y='194' width='480' height='52' rx='10' fill='#fff' stroke='#e5e5e5'/><text x='80' y='228' font-size='20' fill='#121212'>Gap</text><line x1='548' y1='220' x2='618' y2='220' stroke='#ff4a1c' stroke-width='4' marker-end='url(#a)'/><rect x='625' y='194' width='515' height='52' rx='10' fill='#fff6f2' stroke='#ffd9cc'/><text x='645' y='228' font-size='19' font-family='ui-monospace,Menlo,monospace' fill='#121212'>gap</text><rect x='60' y='258' width='480' height='52' rx='10' fill='#fff' stroke='#e5e5e5'/><text x='80' y='292' font-size='20' fill='#121212'>Padding</text><line x1='548' y1='284' x2='618' y2='284' stroke='#ff4a1c' stroke-width='4' marker-end='url(#a)'/><rect x='625' y='258' width='515' height='52' rx='10' fill='#fff6f2' stroke='#ffd9cc'/><text x='645' y='292' font-size='19' font-family='ui-monospace,Menlo,monospace' fill='#121212'>padding</text><rect x='60' y='322' width='480' height='52' rx='10' fill='#fff' stroke='#e5e5e5'/><text x='80' y='356' font-size='20' fill='#121212'>Hug contents</text><line x1='548' y1='348' x2='618' y2='348' stroke='#ff4a1c' stroke-width='4' marker-end='url(#a)'/><rect x='625' y='322' width='515' height='52' rx='10' fill='#fff6f2' stroke='#ffd9cc'/><text x='645' y='356' font-size='19' font-family='ui-monospace,Menlo,monospace' fill='#121212'>width: fit-content (or auto)</text><rect x='60' y='386' width='480' height='52' rx='10' fill='#fff' stroke='#e5e5e5'/><text x='80' y='420' font-size='20' fill='#121212'>Fill container</text><line x1='548' y1='412' x2='618' y2='412' stroke='#ff4a1c' stroke-width='4' marker-end='url(#a)'/><rect x='625' y='386' width='515' height='52' rx='10' fill='#fff6f2' stroke='#ffd9cc'/><text x='645' y='420' font-size='19' font-family='ui-monospace,Menlo,monospace' fill='#121212'>flex: 1  /  width: 100%</text><rect x='60' y='450' width='480' height='52' rx='10' fill='#fff' stroke='#e5e5e5'/><text x='80' y='484' font-size='20' fill='#121212'>Wrap</text><line x1='548' y1='476' x2='618' y2='476' stroke='#ff4a1c' stroke-width='4' marker-end='url(#a)'/><rect x='625' y='450' width='515' height='52' rx='10' fill='#fff6f2' stroke='#ffd9cc'/><text x='645' y='484' font-size='19' font-family='ui-monospace,Menlo,monospace' fill='#121212'>flex-wrap: wrap</text><rect x='60' y='514' width='480' height='52' rx='10' fill='#fff' stroke='#e5e5e5'/><text x='80' y='548' font-size='20' fill='#121212'>Grid flow</text><line x1='548' y1='540' x2='618' y2='540' stroke='#ff4a1c' stroke-width='4' marker-end='url(#a)'/><rect x='625' y='514' width='515' height='52' rx='10' fill='#fff6f2' stroke='#ffd9cc'/><text x='645' y='548' font-size='19' font-family='ui-monospace,Menlo,monospace' fill='#121212'>display: grid</text><text x='60' y='640' font-size='20' fill='#666'>Close, not identical: check min/max sizes, text wrapping and baseline alignment.</text></svg>